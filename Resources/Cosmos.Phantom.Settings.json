{
  "CosmosDbEmulator": {
    "DatabaseName": "sua_database_aqui",
    "Containers": [
      {
        "Name": "nome_do_seu_container",
        "PartitionKeyPath": "/id",
        "IndexingPolicy": {
          "IndexingMode": "consistent",
          "Automatic": true,
          "IncludedPaths": [
            "/propriedade_1/?",
            "/propriedade_2/?"
          ],
          "ExcludedPaths": [
            "/*",
            "/\"_etag\"/?"
          ],
          "CompositeIndexes": [
            [
              {
                "Path": "/propriedade_1",
                "Order": "ascending"
              },
              {
                "Path": "/propriedade_2",
                "Order": "descending"
              }
            ]
          ]
        }
      }
    ]
  }
}